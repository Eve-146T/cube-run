    <string name="void_line_0">This upgrade does nothing.</string>
    <string name="void_line_1">What did you think was going to happen?</string>
    <string name="void_line_2">Do you never learn?</string>
    <string name="void_line_3">Still nothing.</string>
    <string name="void_line_4">You could have bought something useful.</string>
    <string name="void_line_5">The silence is getting expensive.</string>
    <string name="void_line_6">There is no refund in the dark.</string>
    <string name="void_line_7">You are very persistent.</string>
    <string name="void_line_8">One more will change nothing.</string>
    <string name="void_line_9">Are you sure?</string>
    <string name="void_line_10">Fine.</string>
    <string name="void_line_11">There was more.</string>
    <string name="void_line_12">Don\'t look so pleased.</string>
    <string name="void_line_13">The dark remembers you.</string>
    <string name="void_line_14">Something follows.</string>
    <string name="void_line_15">You cannot see it yet.</string>
    <string name="void_line_16">Keep walking.</string>
    <string name="void_line_17">Even nothing leaves a trace.</string>
    <string name="void_line_18">Almost a shadow.</string>
    <string name="void_line_19">Look behind you.</string>
    <string name="void_line_20">A trail. For your trouble.</string>
    <string name="void_line_21">You are still here.</string>
    <string name="void_line_22">The silence has a shape.</string>
    <string name="void_line_23">It is getting closer.</string>
    <string name="void_line_24">Something wants to keep you safe.</string>
    <string name="void_line_25">Or keep you here.</string>
    <string name="void_line_26">A little more darkness.</string>
    <string name="void_line_27">You feel it now.</string>
    <string name="void_line_28">One thin veil.</string>
    <string name="void_line_29">Breathe.</string>
    <string name="void_line_30">The dark surrounds you.</string>
    <string name="void_echo_0">Nothing more. Probably.</string>
    <string name="void_echo_1">The void appreciates your donation.</string>
    <string name="void_echo_2">We have been here before.</string>
    <string name="void_echo_3">Still listening?</string>
    <string name="void_echo_4">The silence deepens.</string>
