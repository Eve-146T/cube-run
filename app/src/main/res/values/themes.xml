<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GameTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- RESTART relaunches this activity in-task (start + finish, see
             GameChromeView) to let libGDX free its native GL resources. Zero-length
             activity animations keep that swap an instant in-place cut instead of a
             slide/fade "new screen". Must be a real 0-duration anim, not @null:
             resource id 0 means "unspecified", and the system substitutes its
             default transition. (Task* animations are left alone — the system
             ignores app values for task transitions on Android 12+ anyway, and
             entering/leaving the app may animate normally.) -->
        <item name="android:windowAnimationStyle">@style/NoWindowAnim</item>
    </style>

    <!-- In-app activity transitions replaced with an instant cut. -->
    <style name="NoWindowAnim">
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>
</resources>
